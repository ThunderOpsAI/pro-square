generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum AiTriageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum QuoteStatus {
  DRAFT
  SENT
  WON
  LOST
  INVOICED
  PAID
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Quote {
  id                String          @id @default(cuid())
  firstName         String
  lastName          String
  email             String
  phone             String
  projectType       String
  message           String
  status            LeadStatus      @default(NEW)
  aiSummary         String?         @db.Text
  aiEstimateLow     Float?
  aiEstimateHigh    Float?
  aiDraftProposal   String?         @db.Text
  aiTriageStatus    AiTriageStatus  @default(PENDING)
  ipHash            String?
  turnstileVerified Boolean         @default(false)
  source            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  detailedQuotes    DetailedQuote[]

  @@index([status])
  @@index([createdAt])
}

model DetailedQuote {
  id                  String              @id @default(cuid())
  leadId              String?
  lead                Quote?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quoteNumber         String              @unique
  customerName        String
  customerEmail       String
  customerPhone       String?
  projectAddress      String?
  projectType         String              @default("General Tiling")
  scopeDescription    String?             @db.Text
  status              QuoteStatus         @default(DRAFT)

  // Tile & Area Specifications
  areaM2              Float               @default(0)
  wastagePercent      Float               @default(10)
  tileLengthMm        Float?              @default(600)
  tileWidthMm         Float?              @default(600)
  tileThicknessMm     Float?              @default(10)
  groutJointMm        Float?              @default(2)
  trowelSizeMm        Float?              @default(10)
  isWetArea           Boolean             @default(false)

  // Auto-calculated Materials
  tilesNeededM2       Float               @default(0)
  tilesBoxCount       Int?                @default(0)
  adhesiveBags        Float               @default(0)
  groutKg             Float               @default(0)
  siliconeTubes       Int                 @default(0)
  waterproofingLitres Float               @default(0)
  primerLitres        Float               @default(0)
  clipsCount          Int                 @default(0)

  // Financial Breakdown
  materialCost        Float               @default(0)
  labourDays          Float               @default(0)
  labourDayRate       Float               @default(0)
  labourCost          Float               @default(0)
  otherCost           Float               @default(0)
  totalCost           Float               @default(0)
  markupPercent       Float               @default(0)
  profitMarginPercent Float               @default(0)
  grossProfit         Float               @default(0)
  subtotalExGst       Float               @default(0)
  gstAmount           Float               @default(0)
  totalIncGst         Float               @default(0)

  // Proposal & Milestones
  proposalText        String?             @db.Text
  depositRequired     Float               @default(0)
  notes               String?             @db.Text
  sentAt              DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  items               QuoteItem[]
  transactions        BudgetTransaction[]

  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id          String        @id @default(cuid())
  quoteId     String
  quote       DetailedQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name        String
  category    String        @default("MATERIAL")
  quantity    Float         @default(1)
  unit        String        @default("item")
  unitCost    Float         @default(0)
  unitPrice   Float         @default(0)
  totalCost   Float         @default(0)
  totalPrice  Float         @default(0)
  notes       String?

  @@index([quoteId])
}

model BudgetTransaction {
  id              String          @id @default(cuid())
  quoteId         String?
  quote           DetailedQuote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  type            TransactionType
  category        String          @default("GENERAL")
  amount          Float
  gstAmount       Float           @default(0)
  isTaxDeductible Boolean         @default(true)
  description     String
  date            DateTime        @default(now())
  reference       String?
  paymentMethod   String?         @default("BANK_TRANSFER")
  isPersonal      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([type])
  @@index([category])
  @@index([date])
  @@index([quoteId])
}

model MaterialPreset {
  id                        String   @id @default(cuid())
  name                      String   @unique
  adhesiveCoveragePerBag    Float    @default(4.5)
  adhesiveBagCost           Float    @default(35.0)
  groutCostPerKg            Float    @default(8.0)
  siliconeCostPerTube       Float    @default(18.0)
  waterproofingCostPerLitre Float    @default(22.0)
  defaultDayRate            Float    @default(650.0)
  defaultWastagePercent     Float    @default(10.0)
  updatedAt                 DateTime @updatedAt
}

model CallLog {
  id        String   @id @default(cuid())
  intent    String   @default("call")
  referrer  String?
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
