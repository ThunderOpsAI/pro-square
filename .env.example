# ==============================================================================
# PRO SQUARE TILING - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# 1. Database (PostgreSQL)
# Prisma 7 PostgreSQL connection string (Neon / Supabase / Railway / Local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pro_square?schema=public"

# 2. AI Engine (Google Gemini API via @google/genai)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Transactional Email Service (Resend)
# Get your API key at: https://resend.com/
RESEND_API_KEY="re_123456789"
BUSINESS_OWNER_EMAIL="owner@prosquaretiling.com"
RESEND_FROM_EMAIL="Pro Square Tiling <onboarding@resend.dev>"

# 4. Bot Protection (Cloudflare Turnstile)
# Get your site & secret keys at: https://dash.cloudflare.com/?to=/:account/turnstile
CLOUDFLARE_TURNSTILE_SECRET_KEY="0x4AAAAAA..."
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="0x4AAAAAA..."

# 5. Admin Authentication & Session
ADMIN_EMAIL="admin@prosquaretiling.com"
ADMIN_PASSWORD="AdminSecure2026!"
ADMIN_NAME="Master Admin"
# 32+ characters secret used by iron-session to seal cookies
ADMIN_SESSION_SECRET="pro-square-secure-admin-session-secret-key-32-chars-minimum-prod"

# 6. Public Business Config
NEXT_PUBLIC_BUSINESS_PHONE="0467 551 492"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
